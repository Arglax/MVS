<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MoVibeSkua.Android.ViewModels"
             xmlns:v="clr-namespace:MoVibeSkua.Android.Views"
             x:Class="MoVibeSkua.Android.Views.SupportView"
             x:DataType="vm:SupportViewModel">
    <ThemeVariantScope RequestedThemeVariant="Dark">
        <Border Classes="aqw-page">
            <v:InfoHost>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,8,10,12">
                        <Border Classes="page-band" Margin="0,2,0,8"><TextBlock Text="FROM THE DEV" /></Border>
                        <TextBlock Classes="page-text" Margin="0,0,0,6"
                                   Text="I wanna make a more mobile-friendly experience for AE games so here we go. Also couldn't find a bot for mobile so I made one. Appreciate my work? Support me through BuyMeACoffee." />
                        <TextBlock Classes="page-text" Margin="0,0,0,4"
                                   Text="I don't make the scripts (got no more time and money), they're from the Skua, VibeSkua and Tato team (AUQW), so report script problems to them (and support them!) instead." />
                        <TextBlock Classes="page-name" HorizontalAlignment="Right" Text="Arglax" />
                        <Border Classes="page-band"><TextBlock Text="QUICK SETTINGS" /></Border>
                        <UniformGrid Rows="1" Margin="-3,0">
                            <Button Classes="guide-jump" Margin="3,0" HorizontalAlignment="Stretch" Content="Headless mode"
                                    Command="{Binding EnterHeadlessCommand}" />
                            <Button Classes="guide-jump" Margin="3,0" HorizontalAlignment="Stretch" Content="Graphics"
                                    Command="{Binding OpenGraphicsCommand}" />
                        </UniformGrid>
                        <Border Classes="page-band"><TextBlock Text="WILL IT RUN WELL?" /></Border>
                        <Button Classes="guide-action" HorizontalAlignment="Stretch" Content="Check my phone"
                                Command="{Binding OpenCheckCommand}" />
                        <Border Classes="page-band"><TextBlock Text="NEED HELP?" /></Border>
                        <UniformGrid Rows="1" Margin="-3,0,-3,6">
                            <Button Classes="guide-action" Margin="3,0" HorizontalAlignment="Stretch" Content="MVS Discord"
                                    Command="{Binding OpenDiscordCommand}" />
                            <Button Classes="guide-jump" Margin="3,0" HorizontalAlignment="Stretch" Content="Script team Discord"
                                    Command="{Binding OpenAuqwDiscordCommand}" />
                        </UniformGrid>
                        <v:InfoText Classes="page-sub" Margin="0,0,0,6"
                                    Markup="App problem: MVS Discord. Script problem: the [team|script team]." />
                        <Button Classes="guide-jump" HorizontalAlignment="Stretch" Command="{Binding ReportProblemCommand}"
                                IsEnabled="{Binding SendReports}">
                            <TextBlock Text="{Binding ReportButtonText}" TextWrapping="Wrap" TextAlignment="Center" />
                        </Button>
                        <Border Classes="page-band"><TextBlock Text="PRIVACY" /></Border>
                        <Border Classes="page-row">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="page-name" Text="Send crash reports" />
                                    <v:InfoText Classes="page-sub" Markup="MVS tells you what happened, then sends a [report|crash report] when you press OK. Off: it sends bare minimum info." />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding SendReports}" OnContent="" OffContent="" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Classes="page-row" BorderThickness="0">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="page-name" Text="Send anonymous usage stats" />
                                    <v:InfoText Classes="page-sub" Markup="[stats|Usage numbers] only. Never your name, login or chat." />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding SendUsage}" OnContent="" OffContent="" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Classes="page-band"><TextBlock Text="SUPPORT MVS" /></Border>
                        <TextBlock Classes="page-text" Margin="0,0,0,6" Text="MVS is free and stays free. Tips are optional and unlock nothing." />
                        <UniformGrid Rows="1" Margin="-3,0">
                            <Button Classes="guide-jump" Margin="3,0" HorizontalAlignment="Stretch" Content="Buy Me a Coffee"
                                    Command="{Binding OpenBuyMeACoffeeCommand}" />
                            <Button Classes="guide-jump" Margin="3,0" HorizontalAlignment="Stretch" Content="Ko-fi"
                                    Command="{Binding OpenKoFiCommand}" />
                        </UniformGrid>
                        <Border Classes="page-card" Margin="0,8,0,0" IsVisible="{Binding HasInstaPay}">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="page-name" Text="InstaPay" />
                                <TextBlock Classes="page-text" Text="{Binding InstaPayNameText}" />
                                <SelectableTextBlock Text="{Binding InstaPayNumberText}" FontSize="15" />
                                <TextBlock Classes="page-sub" Text="Send from any bank or e-wallet app with InstaPay." />
                            </StackPanel>
                        </Border>
                        <Border Classes="page-band"><TextBlock Text="CREDITS" /></Border>
                        <TextBlock Classes="page-text" Margin="0,0,0,6" Text="MVS stands on other people's work:" />
                        <TextBlock Classes="page-name" Text="Skua" />
                        <TextBlock Classes="page-sub" Text="• Breno_Henrike: creator (0.1 to 1.2.3)" />
                        <TextBlock Classes="page-sub" Text="• Purple: maintainer (1.2.4 to 1.4.3.0)" />
                        <TextBlock Classes="page-sub" Text="• Tato: script team manager" />
                        <TextBlock Classes="page-sub" Text="• Bogali: secondary script manager" />
                        <TextBlock Classes="page-sub" Text="• Vanilla99: Ultras v1" />
                        <TextBlock Classes="page-sub" Text="• Crow: script dev (Ultra v3)" />
                        <TextBlock Classes="page-sub" Text="• Lonewolf_12: script dev" />
                        <TextBlock Classes="page-sub" Text="• The auqw script community: scripts and skill rotations" />
                        <TextBlock Classes="page-name" Margin="0,6,0,0" Text="VibeSkua" />
                        <TextBlock Classes="page-sub" Text="• Renoir Dessendre: creator of the VibeSkua branch MVS builds on" />
                        <TextBlock Classes="page-sub" Text="• ArrowDev (BlackArrow): the early Avalonia port" />
                        <TextBlock Classes="page-name" Margin="0,6,0,0" Text="Also" />
                        <TextBlock Classes="page-sub" Text="• Ruffle: Flash emulation" />
                        <TextBlock Classes="page-sub" Text="• r/AQW Simplified Bosses Guide: the class star ratings" />
                        <Button Classes="guide-jump" Margin="0,10,0,0" HorizontalAlignment="Stretch" Content="Support the Skua team"
                                Command="{Binding OpenSkuaDonationsCommand}" />
                        <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" Padding="8,4" Margin="0,8,0,0"
                                Command="{Binding VersionTapCommand}">
                            <TextBlock Text="{Binding VersionText}" Opacity="0.6" FontSize="12" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </v:InfoHost>
        </Border>
    </ThemeVariantScope>
</UserControl>
