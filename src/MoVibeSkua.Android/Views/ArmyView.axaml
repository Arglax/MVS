<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:MoVibeSkua.Android.ViewModels"
             xmlns:v="clr-namespace:MoVibeSkua.Android.Views"
             x:Class="MoVibeSkua.Android.Views.ArmyView"
             x:DataType="vm:ArmyViewModel">
    <ThemeVariantScope RequestedThemeVariant="Dark">
        <Border Classes="aqw-page">
            <v:InfoHost>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,8,10,12">
                        <Border Classes="page-band" Margin="0,2,0,8"><TextBlock Text="ARMY" /></Border>
                        <v:InfoText Classes="page-text" Margin="0,0,0,6"
                                    Markup="Several accounts at once, each in its own [client|client]." />
                        <UniformGrid Rows="1" Margin="-3,0,-3,6">
                            <Button Classes="guide-action" Margin="3,0" HorizontalAlignment="Stretch" Content="+ Add client"
                                    IsEnabled="{Binding CanAdd}" Command="{Binding AddCommand}" />
                            <Button Classes="guide-jump" Margin="3,0" HorizontalAlignment="Stretch" Content="Butler"
                                    Command="{Binding OpenButlerCommand}" />
                        </UniformGrid>
                        <TextBlock Classes="page-sub" Text="{Binding ThisClient}" />
                        <TextBlock Classes="page-sub" Text="{Binding MemoryText}" />
                        <Border Classes="page-note">
                            <v:InfoText Lead="Note: " Markup="Only the client on screen draws the game. The others keep playing, and stay silent." />
                        </Border>
                        <TextBlock Classes="page-sub" Text="{Binding Warning}" Foreground="#F7C948"
                                   IsVisible="{Binding Warning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Classes="page-sub" Text="{Binding Status}"
                                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <Border Classes="page-band"><TextBlock Text="CLIENTS" /></Border>
                        <ItemsControl ItemsSource="{Binding Clients}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ArmyClientItem">
                                    <Border Classes="page-card">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Classes="page-name" Text="{Binding Title}" />
                                                    <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold" Foreground="#8BE28B"
                                                               VerticalAlignment="Center" IsVisible="{Binding IsThis}" />
                                                </StackPanel>
                                                <TextBlock Classes="page-sub" Text="{Binding Detail}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <materialIcons:MaterialIcon Kind="Play" Width="12" Height="12" VerticalAlignment="Center"
                                                                                Foreground="#8BE28B" IsVisible="{Binding IsScriptRunning}" />
                                                    <TextBlock Classes="page-sub" Text="{Binding ScriptText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="guide-action" VerticalAlignment="Center" MinWidth="76" Content="Switch"
                                                    IsVisible="{Binding CanSwitch}"
                                                    Command="{Binding $parent[ItemsControl].((vm:ArmyViewModel)DataContext).SwitchToCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Grid.Column="2" Classes="mobile-icon" VerticalAlignment="Center"
                                                    IsVisible="{Binding CanClose}"
                                                    Command="{Binding $parent[ItemsControl].((vm:ArmyViewModel)DataContext).CloseCommand}"
                                                    CommandParameter="{Binding}">
                                                <materialIcons:MaterialIcon Kind="Close" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </v:InfoHost>
        </Border>
    </ThemeVariantScope>
</UserControl>
