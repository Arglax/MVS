<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:MoVibeSkua.Android.ViewModels"
             xmlns:fastTravel="clr-namespace:Skua.App.Avalonia.ViewModels.FastTravel"
             xmlns:uc="clr-namespace:Skua.App.Avalonia.UserControls"
             x:Class="MoVibeSkua.Android.Views.MobileJumpView"
             x:DataType="vm:MobileJumpViewModel">
    <ScrollViewer>
        <StackPanel Margin="8" Spacing="10">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                <uc:JumpUserControl DataContext="{Binding Jump}" />
            </Viewbox>
            <Border Background="{DynamicResource SkuaSurfaceBrush}"
                    BorderBrush="{DynamicResource SkuaBorderBrush}"
                    BorderThickness="1"
                    Padding="12"
                    CornerRadius="8">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="BookmarkOutline" Width="16" Height="16"
                                                        Foreground="{DynamicResource SkuaAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Saved Spots" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="skua-button" Command="{Binding ToggleSortCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <materialIcons:MaterialIcon Kind="SortVariant" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="Sort" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="skua-button" Classes.skua-primary="{Binding IsEditing}"
                                Command="{Binding ToggleEditCommand}">
                            <Panel>
                                <TextBlock Text="Edit" IsVisible="{Binding !IsEditing}" VerticalAlignment="Center" />
                                <TextBlock Text="Done" FontWeight="Bold" IsVisible="{Binding IsEditing}" VerticalAlignment="Center" />
                            </Panel>
                        </Button>
                    </Grid>
                    <Border IsVisible="{Binding IsSortOpen}" Padding="6" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{DynamicResource SkuaBorderBrush}">
                        <UniformGrid Columns="2" Rows="2">
                            <Button Classes="skua-button" Margin="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding SortByCommand}" CommandParameter="name" Content="Name A–Z" />
                            <Button Classes="skua-button" Margin="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding SortByCommand}" CommandParameter="map" Content="Map A–Z" />
                            <Button Classes="skua-button" Margin="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding SortByCommand}" CommandParameter="newest" Content="Newest first" />
                            <Button Classes="skua-button" Margin="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding SortByCommand}" CommandParameter="oldest" Content="Oldest first" />
                        </UniformGrid>
                    </Border>
                    <Border Padding="8" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource SkuaBorderBrush}">
                        <StackPanel Spacing="6">
                            <Button Classes="skua-button skua-primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding SaveHereCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="MapMarkerPlus" Width="16" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Text="Save where I stand" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding HereText}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SkuaMutedTextBrush}" />
                        </StackPanel>
                    </Border>
                    <Grid ColumnDefinitions="*,72,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0" Text="{Binding NewMap}" Watermark="Map, e.g. ultraalteon" />
                        <TextBox Grid.Column="1" Text="{Binding NewRoom}" Watermark="Room" TextInputOptions.ContentType="Digits" />
                        <Button Grid.Column="2" Classes="skua-button skua-primary" Command="{Binding AddSpotCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <materialIcons:MaterialIcon Kind="Plus" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="Add" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource SkuaMutedTextBrush}"
                               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Border IsVisible="{Binding IsRenaming}" Padding="8" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{DynamicResource SkuaAccentBrush}">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <TextBox Grid.Column="0" Text="{Binding RenameText}" Watermark="Name" />
                            <Button Grid.Column="1" Classes="skua-button skua-primary" Command="{Binding SaveRenameCommand}" Content="Save" />
                            <Button Grid.Column="2" Classes="skua-button" Command="{Binding CancelRenameCommand}" Content="Cancel" />
                        </Grid>
                    </Border>
                    <TextBlock Text="No saved spots yet." FontSize="12" Foreground="{DynamicResource SkuaMutedTextBrush}"
                               IsVisible="{Binding !Spots.Count}" />
                    <ItemsControl ItemsSource="{Binding Spots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="fastTravel:FastTravelItemViewModel">
                                <Border Margin="0,3" Padding="8,4,4,4" CornerRadius="8" BorderThickness="1"
                                        BorderBrush="{DynamicResource SkuaBorderBrush}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                                                    IsVisible="{Binding $parent[ItemsControl].((vm:MobileJumpViewModel)DataContext).IsEditing}">
                                            <Button Classes="mobile-icon"
                                                    Command="{Binding $parent[ItemsControl].((vm:MobileJumpViewModel)DataContext).MoveUpCommand}"
                                                    CommandParameter="{Binding}">
                                                <materialIcons:MaterialIcon Kind="ChevronUp" />
                                            </Button>
                                            <Button Classes="mobile-icon"
                                                    Command="{Binding $parent[ItemsControl].((vm:MobileJumpViewModel)DataContext).MoveDownCommand}"
                                                    CommandParameter="{Binding}">
                                                <materialIcons:MaterialIcon Kind="ChevronDown" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="2,0,0,0">
                                            <TextBlock Text="{Binding DescriptionName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource SkuaMutedTextBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} · {1} · {2}">
                                                        <Binding Path="MapName" />
                                                        <Binding Path="Cell" />
                                                        <Binding Path="Pad" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <Panel Grid.Column="2" VerticalAlignment="Center">
                                            <Button Classes="skua-button skua-primary"
                                                    IsVisible="{Binding !$parent[ItemsControl].((vm:MobileJumpViewModel)DataContext).IsEditing}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MobileJumpViewModel)DataContext).TravelToCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <materialIcons:MaterialIcon Kind="RunFast" Width="15" Height="15" VerticalAlignment="Center" />
                                                    <TextBlock Text="Jump" FontWeight="Bold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Orientation="Horizontal" Spacing="2"
                                                        IsVisible="{Binding $parent[ItemsControl].((vm:MobileJumpViewModel)DataContext).IsEditing}">
                                                <Button Classes="mobile-icon"
                                                        Command="{Binding $parent[ItemsControl].((vm:MobileJumpViewModel)DataContext).StartRenameCommand}"
                                                        CommandParameter="{Binding}">
                                                    <materialIcons:MaterialIcon Kind="PencilOutline" />
                                                </Button>
                                                <Button Classes="mobile-icon"
                                                        Command="{Binding $parent[ItemsControl].((vm:MobileJumpViewModel)DataContext).RemoveSpotCommand}"
                                                        CommandParameter="{Binding}">
                                                    <materialIcons:MaterialIcon Kind="Close" />
                                                </Button>
                                            </StackPanel>
                                        </Panel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
